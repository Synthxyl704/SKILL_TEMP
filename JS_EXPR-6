// EXPERIMENT 6.3 - Arithmetic Operations using Switch
console.log("EXPERIMENT 6.3 - Arithmetic Operations using Switch\n");

let numA = 20; 
let numB = 5;

console.log(`numA = ${numA}, numB = ${numB}`);

let operators = ["+", "-", "*", "/"];

for (let operator of operators) {
  let result;
  switch (operator) {
    case "+":
      result = numA + numB;
      break;

    case "-":
      result = numA - numB;
      break;

    case "*":
      result = numA * numB;
      break;

    case "/":
      result = numB !== 0 ? numA / numB : "Error: Division by zero";
      break;
    default:
      result = "Invalid operator";
  }

  console.log(`${numA} ${operator} ${numB} = ${result}`); // Fixed: changed a,b to numA,numB
}

